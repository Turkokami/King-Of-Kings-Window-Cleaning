---
/**
 * BeforeAfter.astro — one property, two photographs, same position, one frame.
 *
 * NOT A DRAG SLIDER. The legacy site uses a handle you drag across the image;
 * that is a client-side JavaScript component and this build ships none. It is
 * also the weaker presentation: a slider shows one state at a time and hides the
 * other behind an interaction most people never perform, and nothing reading the
 * page can extract it. This shows both halves at once, split down the middle in
 * the same style, and works at 320px, in print, and with images disabled.
 */
import type { BeforeAfter } from '../data/photos';

interface Props {
  pairs: BeforeAfter[];
  /** Rendered above the list; omit where the page already has a heading. */
  heading?: string;
}
const { pairs, heading } = Astro.props;
---
{pairs.length > 0 && (
  <section class="ba-section" aria-label={heading ?? 'Before and after'}>
    {heading && <h2>{heading}</h2>}
    <ul class="ba-list">
      {pairs.map((p) => (
        <li>
          <figure class="ba-split">
            <span class="ba-split__frame">
              <span class="ba-split__half">
                <img src={p.before.file} alt={p.before.alt} width={p.before.width} height={p.before.height}
                     loading="lazy" decoding="async" />
                <span class="ba-split__tag">Before</span>
              </span>
              <span class="ba-split__half">
                <img src={p.after.file} alt={p.after.alt} width={p.after.width} height={p.after.height}
                     loading="lazy" decoding="async" />
                <span class="ba-split__tag ba-split__tag--after">After</span>
              </span>
              <span class="ba-split__handle" aria-hidden="true"></span>
            </span>
            <figcaption><strong>{p.label}</strong> — {p.before.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
)}
