---
/**
 * T1 — the home page / hub. Everything links back to it, and its job is to push
 * equity back out. The legacy homepage absorbs 292 inbound internal links and
 * passes 15 out; Mt. Baker's passes 107. That imbalance is why the geo lattice
 * underneath it never ranked.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import ExpertBlock from '../components/ExpertBlock.astro';
import { buildableServices } from '../data/services';
import { MARKETS, marketsByCounty } from '../data/markets';
import { AUTHORISED_CITIES, DECLINED_CITIES } from '../data/authorised';
import { AWARDS, streakClaim } from '../data/awards';
import { BUSINESS, credentialLine } from '../data/business';
import { buildTitle } from '../lib/seo';
import { HOME_HERO, ABOUT_PHOTO, BEFORE_AFTER } from '../data/photos';
import ServiceCards from '../components/ServiceCards.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Photo from '../components/Photo.astro';

/* Part 6A — the home page links to the ten evidenced markets and names the rest. */
const linked = (county: 'Whatcom' | 'Skagit') =>
  marketsByCounty(county).filter((m) => AUTHORISED_CITIES.includes(m.slug));
const alsoServed = MARKETS.filter((m) => DECLINED_CITIES.includes(m.slug)).map((m) => m.name);

const entry = await getEntry('sitePage', 'home')?.catch(() => undefined);
const hasBody = Boolean(entry);
const { Content } = hasBody ? await entry!.render() : { Content: null };
const d = entry?.data;

const answer = d?.answer ?? `King of Kings cleans windows, gutters, roofs and siding across Whatcom and Skagit County, from Bellingham to Anacortes. Owner Randy Fee trains every technician personally. Licensed, L&I insured, hundreds of five-star reviews. Free on-site quote.`;
const faqs = d?.faqs ?? [];
const title = d?.title ?? buildTitle('Window Cleaning in Bellingham WA');

const schema = {
  path: '/',
  title,
  description: d?.metaDescription ?? answer,
  image: d?.heroImage ?? BUSINESS.socialImage,
  imageAlt: d?.heroAlt ?? 'King of Kings Window Cleaning working on a Bellingham home',
  crumbs: [{ name: 'Home', path: '/' }],
  faqs,
};
---
<BaseLayout schema={schema} noindex={!hasBody}>
  <article class="t1-home prose">
    {/*
      STRUCTURE. The legacy home page is a stack of full-width bands — photo hero,
      badge row, about, a dark services band, proof, reviews — and the first
      build was one white column, which read as a single long document. Each
      band below does one job, and the alternating grounds are what tell a reader
      they have moved on to the next one. Content inside every band still sits in
      the same 1120px column, so the reading width never changes.
    */}
    <div class="hero hero--photo">
      <Photo photo={HOME_HERO} priority class="hero__media" />
      <p class="eyebrow">Whatcom &amp; Skagit County · Locally owned</p>
      <h1>Window &amp; Exterior Cleaning in <span class="accent">Bellingham, WA</span></h1>
      <p class="hero__lead">
        Windows, gutters, roofs and siding — cleaned on a schedule that suits a
        wet, wooded, coastal county, from Bellingham to Anacortes.
      </p>

      <AnswerBox text={answer} />

      {/* Trust strip — near the hero, not buried in one block at the bottom (doctrine #5). */}
      <div class="trust-strip">
        <span>{credentialLine()}</span>
        {streakClaim() && <span>{streakClaim()}</span>}
      </div>

      <div class="hero__actions">
        <a class="hero__btn hero__btn--primary" href={`tel:${BUSINESS.phoneE164}`}>Call {BUSINESS.phone}</a>
        <a class="hero__btn hero__btn--ghost" href={BUSINESS.quoteUrl}>Get a free on-site quote</a>
      </div>
    </div>

    {/*
      Every award here is real, dated and attributed to the body that gave it —
      the substantiated replacement for the legacy site's "Bellingham's Best"
      (audit finding P0-5). Listing them is not leading with one: `headline` still
      governs what the CTA is allowed to claim.
    */}
    <section class="band band--grey band--center awards-strip">
      <p class="eyebrow">Recognition</p>
      <h2>Voted for by Whatcom County, not by us</h2>
      {/*
        The badge grid the client's own awards page uses. Every badge is the
        awarding body's artwork, mirrored locally; an award whose badge we do not
        have renders as a plain card rather than borrowing another one's.
      */}
      <ul class="award-grid">
        {AWARDS.map((a) => (
          <li class="award">
            {a.badge
              ? <img src={a.badge} alt={`${a.year} ${a.name} badge — ${a.awardedBy}`} width="420" height="420" loading="lazy" decoding="async" />
              : <span class="award__year" aria-hidden="true">{a.year}</span>}
            <p class="award__label">{a.shortLabel}</p>
            <p class="award__by">{a.year} · {a.awardedBy}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-split">
      <Photo photo={ABOUT_PHOTO} class="about-split__media" />
      <div class="about-split__text">
        <p class="eyebrow">Locally owned · Bellingham</p>
        <h2>Cleaned by the <span class="accent-deep">owner's own crew</span></h2>
        <p>
          King of Kings is run by its owner, Randy Fee, and every technician who
          carries the name onto a property was trained by him. That is the whole
          difference between a local company and a franchise: the person who set the
          standard is the person you can call.
        </p>
        <ul class="check-list">
          <li>Owner-run — every technician trained by Randy personally</li>
          <li>{credentialLine()}</li>
          <li>Free quotes, given in person, on site</li>
          <li>Purified-water glass cleaning and low-pressure soft washing</li>
        </ul>
        <p><a class="hero__btn hero__btn--primary" href={BUSINESS.quoteUrl}>Get a free on-site quote</a></p>
      </div>
    </section>

    <ExpertBlock />

    <section class="band band--navy band--center">
      <p class="eyebrow">What we do</p>
      <h2>How can we help?</h2>
      <ServiceCards />
      <p><a href="/services/">All services</a> · <a href="/gallery/">Our work in photographs</a></p>
    </section>

    <section class="band band--grey">
      <p class="eyebrow">Before and after</p>
      <h2>Same position, same day</h2>
      <BeforeAfter pairs={BEFORE_AFTER.slice(0, 3)} />
      <p><a href="/gallery/">See all {BEFORE_AFTER.length} before-and-after pairs</a></p>
    </section>

    {Content && <Content />}

    {/* The hub distributing outward — every market, both counties. */}
    <section class="band band--grey locations-callout">
      <p class="eyebrow">Service area</p>
      <h2>Where we work</h2>
      <h3>Whatcom County</h3>
      <ul class="locations-callout__grid">
        {linked('Whatcom').map((m) => <li><a href={`/locations/${m.slug}/`}>{m.name}</a></li>)}
      </ul>
      <h3>Skagit County</h3>
      <ul class="locations-callout__grid">
        {linked('Skagit').map((m) => <li><a href={`/locations/${m.slug}/`}>{m.name}</a></li>)}
      </ul>
      <p>{MARKETS.length} markets — <a href="/locations/">full service area</a></p>
    </section>

    <Faq faqs={faqs} />
    <Cta />
  </article>
</BaseLayout>
