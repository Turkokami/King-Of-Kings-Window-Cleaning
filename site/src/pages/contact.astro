---
/**
 * T1 trust — contact. Part 4A.2, contact friction: the primary action above the
 * fold on mobile at 390px, a real tel: link everywhere the number appears, and
 * the form posting to a destination the client owns.
 *
 * The form here is deliberately NOT rebuilt: Keystone 4A.2 says to embed the
 * client's existing CRM form on a static build, because a static site cannot
 * send mail and rebuilding the form silently destroys their lead tracking.
 *
 * RESOLVED 23 Sep 2026, at the operator's direction. The client's CRM form was
 * already on the site: it is inside the LeadConnector widget — "Get a Free
 * Estimate", collecting name, phone and a message, with an SMS consent checkbox
 * — and this was the one page it had been excluded from, under Part 4A.1, as an
 * action competing with call and quote. On the page whose whole job is lead
 * capture that reasoning is backwards. The widget now loads here and the page's
 * own quote button opens it.
 *
 * That button used to point at BUSINESS.quoteUrl, which is '/contact/' — this
 * page. The single control on the site's conversion page reloaded the page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import { BUSINESS, trustLine } from '../data/business';
import { buildTitle } from '../lib/seo';

export const prerender = true;

const answer = `Call ${BUSINESS.phone} or request a quote online. Quotes are free, on site and in person — we walk the property with you, tell you what actually needs doing this cycle and what can wait, and price the work in front of us.`;

const schema = {
  path: '/contact/',
  title: buildTitle('Contact — Free On-Site Quote'),
  description: `Call King of Kings Window Cleaning on ${BUSINESS.phone} or request a free on-site quote across Whatcom and Skagit County.`,
  image: '/brand/king-of-kings-social.jpg',
  imageAlt: 'Contact King of Kings Window Cleaning',
  crumbs: [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }],
  faqs: [],
  pageType: 'ContactPage' as const,
};
---
<BaseLayout schema={schema}>
  <article class="t1 prose">
    <h1>Contact</h1>
    <AnswerBox text={answer} label="How to reach us" />

    <section class="contact-actions">
      <h2>The quickest way</h2>
      <p>
        <a class="cta__btn cta__btn--primary" href={`tel:${BUSINESS.phoneE164}`}
           aria-label={`Call King of Kings Window Cleaning on ${BUSINESS.phone}`}>
          Call {BUSINESS.phone}
        </a>
        {/*
          Opens the CRM's own quote form (ChatWidget.astro wires every
          [data-open-chat] control). It ships hidden and is revealed by that
          script, so it is never shown to a visitor whose browser could not open
          it — they get the phone number and the email address, which work
          without JavaScript and are on this page anyway.
        */}
        <button type="button" class="cta__btn" data-open-chat hidden>
          Request a quote online
        </button>
      </p>
      <p>
        The quote form asks for your name, a number to reach you on, and what you
        want looked at. It goes straight to the office — nobody is sitting in a
        queue somewhere else.
      </p>
      <p><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></p>
      <p>{trustLine()}</p>
    </section>

    <section>
      <h2>What happens after you call</h2>
      <ol>
        <li><strong>We book a walk-round</strong>, usually within the week in Bellingham, Ferndale and Lynden.</li>
        <li><strong>We look at the property with you</strong> and say which surfaces have growth, which have deposit, and which have simply weathered.</li>
        <li><strong>You get a number for the work in front of us</strong> — not a phone estimate, which in a region where condition varies this much street to street is a guess.</li>
        <li><strong>Nothing starts until you have agreed what is in it.</strong></li>
      </ol>
    </section>

    <section>
      <h2>Where we work</h2>
      <p>
        Whatcom and Skagit County. <a href="/locations/">The service area page</a>
        lists the towns with their own pages and names the ones we cover without
        one — if you are not sure whether you are inside it, call and ask.
      </p>
    </section>
  </article>
</BaseLayout>
